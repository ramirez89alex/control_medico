{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w packages/shared && npm run build -w apps/api"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/src/index.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
