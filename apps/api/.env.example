DATABASE_URL="postgresql://powerdent:powerdent@localhost:5432/powerdent"
PORT=4000
JWT_ACCESS_SECRET="cambia-esto-en-produccion-access"
JWT_REFRESH_SECRET="cambia-esto-en-produccion-refresh"
CORS_ORIGIN="http://localhost:5173"

# S3-compatible (MinIO local por defecto, ver docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="powerdent"
S3_ACCESS_KEY_ID="powerdent"
S3_SECRET_ACCESS_KEY="powerdent123"
S3_FORCE_PATH_STYLE="true"

# Asistente de voz de la Agenda (opcional): sin esta clave el asistente
# responde con un aviso claro en vez de interpretar la orden.
ANTHROPIC_API_KEY=""
